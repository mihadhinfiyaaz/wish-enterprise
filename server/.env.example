# Copy to .env to override defaults (all optional).
PORT=4000
# Absolute or relative path to the SQLite database file.
DB_PATH=./data/hanger.db
# Password for the /admin panel (CHANGE THIS in production).
# It is bcrypt-hashed into the admin_users table on first seed.
ADMIN_PASSWORD=wishadmin

# Serve over HTTPS. If no cert files are given, a self-signed cert is generated
# (development only). For production, point these at real cert/key files.
HTTPS=false
# SSL_KEY_FILE=./certs/key.pem
# SSL_CERT_FILE=./certs/cert.pem
